aster_HasDasboard;\r\n        var Master_CurrentPageLink='';\r\n        var MS_UrlRoot='';\r\n        var MS_UrlChild='';\r\n        var MS_UrlHome='';\r\n      \r\n        // #endregion\r\n       \r\n        \r\n        //#region // Third Party\r\n\r\n        \r\n\r\n        //#region // Skinscan\r\n        var syn_Skinscanbrand=Master_Data?.sys_SkinscanBrand;\r\n        var syn_SkinscanAppID=Master_Data?.sys_SkinscanAppID;\r\n        //#endregion\r\n\r\n        //#region // DuocQuocGia\r\n        var syn_Drugbrand=Master_Data?.sys_DrugBrand;\r\n        var syn_DrugType=Master_Data?.sys_DrugType;\r\n        //#endregion\r\n\r\n        //#region // DonThuocQuocGia\r\n        var syn_Medbrand=Master_Data?.sys_MedBrand;\r\n        var syn_MedType=Master_Data?.sys_MedType;\r\n        //#endregion\r\n\r\n        //#region //Pancake\r\n        var syn_PancakeURL=Master_Data?.sys_PancakeURL;\r\n        //#endregion\r\n\r\n        //#endregion\r\n        //#region // Minify\r\n        var sys_Minify=Master_Data.sys_Minify;\r\n        //#endregion\r\n\r\n\t\t//#region // HubAPI rules\r\n\t\tvar sys_HubApiRules = {};\r\n\t\t//#endregion\r\n\r\n\t\t//#region // USER Extra Config\r\n\t\tvar sys_UserExtraConfig = {};\r\n\t\t//#endregion\r\n\r\n        //#region // DAILY\r\n        var sys_TokenDaily;\r\n\r\n        //#endregion\r\n\r\n\r\n\r\n\t\tvar sys_PositionPopup = {};\r\n        var Master_Currency ;\r\n\t\t//#region // Load JS , Customer Layout\r\n \r\n        var Master_PromiseMasterTop;\r\n        var formClass=[\"flogic\"];\r\n        var formClassError={};\r\n        var Outlang={};\r\n\r\n       \r\n\r\n        Master_Asign_Value_Initiliaze();\r\n        SWCache.LoadJSHeader(function(_landist) {\r\n            Master_Currency=(typeof DCCompany!==\"undefined\")? (DCCompany.Data.Currency??'VND'):'VND';\r\n            if(typeof SRounding!==\"undefined\") SRounding.init(Master_Data.roundingConfig);\r\n            formClassError={\r\n                \"flogic-dupp\": Outlang[\"Trung_du_lieu\"],\r\n                \"flogic-stockquan\": Outlang[\"Khong_du_hang\"]||\"\"\r\n            };\r\n            SWCache.resumeReady();\r\n        });\r\n\r\n\r\n        $(document).ready(function () {\r\n            try { ThemeService.applyAfterDOM(); } catch { }\r\n\r\n            Master_fixMissFunction();\r\n            Master_ReadContentCollapse();\r\n            $(\"#BodyMain\").fadeIn(200);\r\n            $(\".navbarBlur\").fadeIn(200);\r\n            Master_LoginFrom();\r\n\r\n            Master_Load_Value_Initiliaze();\r\n            Master_HandleMenu();\r\n            SM.initIconSprite('vt-svg-sprite'); \r\n  \r\n            if(isFunction(Master_CustConnect_Init)) Master_CustConnect_Init(); \r\n\r\n        });\r\n\r\n        \r\n\r\n        function Master_Asign_Value_Initiliaze() {\r\n             \r\n            versionofWebApplication=Master_Data._versionofWebApplication;\r\n            Master_HasDasboard=Master_Data.HasDashboard;\r\n            _GuideForCurrentPage='[]';\r\n            Master_branchNameCurrent=Master_Data._branchNameCurrent;\r\n            Master_branchFullName=Master_Data._branchFullName;\r\n            Master_branchCode=Master_Data._branchCode;\r\n            Master_branchAddress=Master_Data._branchAddress;\r\n\r\n            Master_branchID=Master_Data._branchIDCurrent;\r\n            Master_roleGroupCurrent=Master_Data._roleGroupCurrent;\r\n \r\n            Master_roleID=Master_Data._roleIDCurrent;\r\n            Master_areaBranch=Master_Data._areaBranch;\r\n            Master_isAllBranch=Master_Data._isAllBranch;\r\n            Master_circleAvatar=Master_Data._circleAvatar;\r\n            sys_employeeID_Main=Master_Data._employeeID_Main;\r\n            sys_dencos_Main=Master_Data._dencos_Main;\r\n\r\n            MS_UrlHome=Master_Data.FirstPageAccess\r\n\r\n            sys_employeeName_Main=Master_Data._employeeName_Main;\r\n\r\n            sys_TeleLevel=Master_Data.UserTeleLevel;\r\n            sys_TeleGroup=Master_Data.UserTeleGroup;\r\n\r\n            sys_userID_Main=Master_Data._userID_Main;\r\n            sys_userName_Main=Master_Data._userNameCurrent;\r\n            Master_userPopupMenu=JSON.parse(Master_Data._userPopupMenu);\r\n            PermissionTableMenu=JSON.parse(Master_Data.PermissionTable_Menu);\r\n \r\n\r\n            Sys_LibName=Master_Data.LibraryData;\r\n \r\n           \r\n\t\t\tif((Master_Data?._sys_HubApiRules ?? \"\") != \"\") {\r\n\t\t\t\tsys_HubApiRules =  JSON.parse(Master_Data._sys_HubApiRules)\r\n\t\t\t\t\t.reduce((pre, arr) => {\r\n\t\t\t\t\t\tif((arr?.ModuleName ?? \"\") != \"\") {\r\n\t\t\t\t\t\t\tpre[(arr.ModuleName).trim()] = arr;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\treturn pre; }\r\n\t\t\t\t\t, {});\r\n\t\t\t}\r\n            if((Master_Data?.sys_TokenDaily ?? \"\") != \"\") {\r\n                sys_TokenDaily = Master_Data?.sys_TokenDaily?.split(\",\")?.map(x => x.toLowerCase())\r\n\t\t\t}\r\n\r\n \r\n\r\n\t\t};\r\n\r\n        function Master_Load_Value_Initiliaze() {  \r\n            $('#SoftwareSmallLogo').attr('src',DCCompany.Data.SoftwareSmallLogo);\r\n            (DCCompany.Data.SoftwareLogo!='')? ($('#SoftwareLogo').attr('src',DCCompany.Data.SoftwareLogo)):($('#SoftwareLogo').attr('src',Master_Default_Pic));\r\n            $('#SoftwareLogo').show();\r\n            Master_RefeshNavbar();  \r\n\r\n        }\r\n\r\n        function Master_RefeshNavbar() {\r\n            if ($('#BodyMain').hasClass('menutop-version')) {\r\n                $('#navbarBlurtop').empty();\r\n                Master_PromiseMasterTop = Master_LoadNavTop(\"navbarBlurtop\") \r\n                $(\"#navbarBlurtop\").show();\r\n            }\r\n            else {\r\n                $('#navbarBlur').empty();\r\n                Master_PromiseMasterTop = Master_LoadNavTop(\"navbarBlur\");\r\n                $(\"#navbarBlur\").show();\r\n            }\r\n            $(\"#Master_Right\").load(\"/Master/Master_Right?ver=\"+versionofWebApplication);\r\n        }\r\n\r\n        function Master_LoadNavTop(id) {\r\n            return new Promise((resolve) => {\r\n                $(\"#\"+id).load(\"/Master/Master_Top?ver=\"+versionofWebApplication,function(response,status,xhr) {\r\n                    if(status===\"success\") {\r\n                        resolve(response);\r\n                    }\r\n                });\r\n            })\r\n        } \r\n\r\n        //#endregion\r\n \r\n\r\n        //#region // Handle Menu Master Page\r\n\r\n        function Master_HandleMenu() {\r\n            RenderMenuDesktop(PermissionTableMenu,\"menuDesktopCategory\",\"TTmenu_Top\");\r\n            Master_EventRedirect();\r\n            Master_Evenmenutop();\r\n            Master_CheckingMenuSelected();\r\n        }\r\n\r\n        function Master_CheckingMenuSelected() {\r\n            let url=window.location.pathname;\r\n            if($('#BodyMain').hasClass('menutop-version')) {\r\n                $(\"#TTmenu_Top .menudesktop_render\").each((idx,ele) => {\r\n                    let currlink=$(ele).attr(\"href\");\r\n                    if(currlink.includes(url)) {\r\n                        if(ele.id!=\"menuCustomerCreate\"&&ele.id!=\"menuAppmonitor\") {\r\n                            MS_UrlRoot=\"\";\r\n                            MS_UrlChild=$(ele).text();\r\n                            Master_SetTitle();\r\n                        }\r\n                    }\r\n\r\n                });\r\n            }\r\n            else {\r\n                $(\"#menuDesktopCategory .menudesktop_render\").each((idx,ele) => {\r\n                    let currlink=$(ele).attr(\"href\");\r\n                    $(ele).removeClass(\"active\");\r\n                    if(currlink==url) {\r\n                        if(ele.id!=\"menuCustomerCreate\"&&ele.id!=\"menuAppmonitor\") {\r\n                            $(ele).addClass(\"active\");\r\n                            let collapseItem=$(ele).closest(\".collapsesticky\");\r\n                            let collapseItemContent=collapseItem.parent().siblings('.nav-item');\r\n                            collapseItem.siblings('.nav-link').addClass(\"active\");\r\n                            collapseItem.addClass(\"show\");\r\n                            collapseItemContent.children('.menuparent_render').removeClass('active');\r\n                            collapseItemContent.children('.collapsesticky').removeClass('show');\r\n                            MS_UrlRoot=collapseItem.siblings('.nav-link').find(\".nav-link-text\").text();\r\n                            MS_UrlChild=$(ele).children('.sidenav-normal').text();\r\n                            Master_SetTitle();\r\n                        }\r\n                    }\r\n                });\r\n            }\r\n\r\n\r\n        }\r\n        function Master_SetTitle() {\r\n            try {\r\n                if(MS_UrlRoot!=\"\"||MS_UrlChild!=\"\") {\r\n                    document.title=MS_UrlRoot!=\"\"? (MS_UrlRoot+' - '+MS_UrlChild):MS_UrlChild;\r\n                }\r\n                else document.title='VTTECH SOLUTION';\r\n            }\r\n            catch(ex) {\r\n                document.title='VTTECH SOLUTION';\r\n            }\r\n        }\r\n        function Master_Evenmenutop() {\r\n\r\n            $('#TTmenu_Top .nav-link:not(#menuCustomerCreate):not(#menuAppmonitor)').unbind('click').click(function(e) {\r\n                e.preventDefault();\r\n\r\n                if($(this).hasClass('active')) {\r\n                    $('#TTmenu_Top .nav-link').removeClass(\"active\").removeClass(\"show\");\r\n                    $('#TTmenu_Top .dropdown-menu').removeClass(\"show\");\r\n                }\r\n                else {\r\n                    $('#TTmenu_Top .nav-link').removeClass(\"active\").removeClass(\"show\");\r\n                    $('#TTmenu_Top .dropdown-menu').removeClass(\"show\");\r\n\r\n                    $(this).addClass(\"active\").addClass(\"show\");\r\n                    $(this).siblings(\".dropdown-menu\").addClass(\"show\");\r\n                }\r\n\r\n\r\n            })\r\n        }\r\n        function Master_EventRedirect() {\r\n\r\n            $('#menuDesktopCategory').on('click','.menuparent_render',function(e) {\r\n                $('#menuDesktopCategory .menuparent_render').removeClass('active');\r\n                $(this).closest(\".collapsesticky\").siblings(\".menuparent_render\").addClass(\"active\");\r\n                $(this).addClass(\"active\");\r\n            })\r\n            $('#menuDesktopCategory').on('click','.menudesktop_render',function(e) {\r\n\r\n                e.preventDefault();\r\n                $('#menuDesktopCategory .menudesktop_render').removeClass('active');\r\n                let namechild='',namegroup='';\r\n                namechild=$(this).attr(\"data-name\");\r\n                $(this).addClass('active');\r\n                let objparent=$(this).parent().parent();\r\n                if(objparent!=undefined) {\r\n                    objparent.addClass('active');\r\n                    namegroup=objparent.attr(\"data-name\");\r\n                }\r\n                let href=$(this).attr('href');\r\n                MS_UrlRoot=namegroup;\r\n                MS_UrlChild=namechild;\r\n                window.history.pushState(href,'Title',href);\r\n                Master_RedirectLoadPage(href);\r\n                if(sys_isMobile==1) $('#BodyMain').removeClass('g-sidenav-pinned').addClass('g-sidenav-hidden');\r\n            });\r\n            $('#TTmenu_Top').on('click','.menudesktop_render',function(e) {\r\n\r\n                e.preventDefault();\r\n                let namechild='',namegroup='';\r\n                namechild=$(this).attr(\"data-name\");\r\n                let objparent=$(this).parent().parent();\r\n                if(objparent!=undefined) {\r\n                    namegroup=objparent.attr(\"data-name\");\r\n                }\r\n                let href=$(this).attr('href');\r\n                MS_UrlRoot=namegroup;\r\n                MS_UrlChild=namechild;\r\n                window.history.pushState(href,'Title',href);\r\n                Master_RedirectLoadPage(href);\r\n            });\r\n            window.addEventListener('popstate',function(e) {\r\n                if(e.state) Master_RedirectLoadPage(e.state);\r\n            });\r\n            Master_CurrentPageLink=window.location.pathname\r\n        }\r\n\r\n        function Master_RedirectLoadPage(href) {\r\n            try {\r\n                if(href!='#') {\r\n                    Master_CheckingMenuSelected();\r\n                    Master_CurrentPageLink=href.toLowerCase();\r\n                    let hreflayoutnone=href+(href.includes(\"?\")? \"&\":\"?\")+'layout=none'+'&ver='+versionofWebApplication;\r\n                    $(\"#MainRenderBody\").empty().hide();\r\n                    $(\"#MainRenderBody_Manual\").hide();\r\n                    $(\"#MainRenderBody_Manual\").load(hreflayoutnone,function() {\r\n                        $(this).fadeIn(100);\r\n                        MS_SetHeaderNavi();\r\n                        Master_SetTitle()\r\n                    });\r\n                }\r\n            }\r\n            catch(ex) {\r\n\r\n            }\r\n        }\r\n\r\n        //#endregion\r\n\r\n        //#region // Load from\r\n        async function Master_LoginFrom() {\r\n            new Promise((reolve) => {\r\n                setTimeout(() => {\r\n                    try {\r\n                        AjaxJWT(url=\"/api/LoginIntent/get\"\r\n                            ,data=JSON.stringify({})\r\n                            ,async=true\r\n                            ,success=function(result) {\r\n\r\n                                switch(result) {\r\n                                    case \"checkin\": {\r\n                                        Master_CheckinHR();\r\n                                    }\r\n                                    break;\r\n                                }\r\n                            }\r\n                        );\r\n                    }\r\n                    catch(ex) {\r\n                    }\r\n                },200)\r\n            })\r\n        }\r\n\r\n        function Master_CheckinHR() {\r\n            $(\"#DetailModal_Content\").html('');\r\n            $(\"#DetailModal_Content\").load(\"/HR/Checkin/CheckinDetail?ver=\"+versionofWebApplication);\r\n            $('#DetailModal').modal('show');\r\n            return false;\r\n        }\r\n\r\n        //#endregion\r\n\r\n        // #region // Event\r\n\r\n        function Master_EventAddCustomer() {\r\n\r\n            if($('#menuDesktopCategory #menuCustomerCreate').length) {\r\n                $(\"#menuDesktopCategory #menuCustomerCreate\").unbind('click').click(function(event) {\r\n                    $(\"#DetailModal_Content\").html('');\r\n                    $(\"#DetailModal_Content\").load(\"/Customer/CustomerDetail\"+'?ver='+versionofWebApplication);\r\n                    $('#DetailModal').modal('show');\r\n                });\r\n            }\r\n            if($('#TTmenu_Top #menuCustomerCreate').length) {\r\n                $(\"#TTmenu_Top #menuCustomerCreate\").unbind('click').click(function(event) {\r\n                    $(\"#DetailModal_Content\").html('');\r\n                    $(\"#DetailModal_Content\").load(\"/Customer/CustomerDetail\"+'?ver='+versionofWebApplication);\r\n                    $('#DetailModal').modal('show');\r\n                });\r\n            }\r\n            if($('#menuDesktopCategory #menuAppmonitor').length) {\r\n                $(\"#menuDesktopCategory #menuAppmonitor\").unbind('click').click(function(event) {\r\n                    window.open(\"/Monitor/General?ver=\"+versionofWebApplication);\r\n                });\r\n            }\r\n            if($('#TTmenu_Top #menuAppmonitor').length) {\r\n                $(\"#TTmenu_Top #menuAppmonitor\").unbind('click').click(function(event) {\r\n                    window.open(\"/Monitor/General?ver=\"+versionofWebApplication);\r\n                });\r\n            }\r\n        }\r\n\r\n        function Master_ChangeBranchMulti() {\r\n            $(\"#DetailModal_Content\").html('');\r\n            $(\"#DetailModal_Content\").load(\"/ChangeBranch/ChangeBranch?ver=\"+versionofWebApplication);\r\n            $('#DetailModal').modal('show');\r\n            return false;\r\n        }\r\n\r\n        function Master_Update_Branch() {\r\n            AjaxJWT(url=\"/api/Author/BaseData\"\r\n                ,data=JSON.stringify({})\r\n                ,async=true\r\n                ,success=function(result) {\r\n                    localstorage_set(session_base,JSON.parse(result));\r\n                    location.reload();\r\n                }\r\n            );\r\n        } \r\n\r\n        \r\n        //#endregion\r\n        //#region // Svg icon\r\n\r\n        //#endregion\r\n\r\n        //#region // check curent user\r\n        function Master_checkUserCurrentTab() {\r\n            try {\r\n                let userInpage=sys_userName_Main.toLowerCase().trim();\r\n                let userNew='';\r\n                if(author_get(\"author\")!='') {\r\n                    userNew=JSON.parse(author_get(\"author\")).username.toLowerCase().trim();\r\n                    if(userInpage!=userNew&&userInpage!='') {\r\n                        Swal.fire({\r\n                            title: \"Th&#xF4;ng b&#xE1;o!\",\r\n                            text: decodeHtml('Trang &#x111;&#xE3; thay &#x111;&#x1ED5;i user.\\n\\Nh&#x1EA5;n OK &#x111;&#x1EC3; t&#x1EA3;i l&#x1EA1;i trang'),\r\n                            type: \"success\"\r\n                        }).then(function() {\r\n                            location.reload();\r\n                        });\r\n                    }\r\n                }\r\n            } catch(ex) {\r\n\r\n            }\r\n        }\r\n \r\n        //#endregion\r\n\r\n        function Master_fixMissFunction(){\r\n            if (!$.fn.tab) {\r\n                $.fn.tab = function(action) {\r\n                    if (action === 'show') {\r\n                        this.forEach ? this.forEach(showTab) : Array.from(this).forEach(showTab);\r\n                    }\r\n                    return this;\r\n                };\r\n\r\n                function showTab(el) {\r\n                    let tabEl = typeof el === 'string' ? document.querySelector(el) : el;\r\n                    if (tabEl) {\r\n                        let tab = new bootstrap.Tab(tabEl);\r\n                        tab.show();\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        //#region // Storage\r\n        function SysStorage_Get() {\r\n            return new Promise((resolve) => {\r\n                if (Number(sys_SpaceStorage) != 0) {\r\n                    $('#fieldStorage').removeClass('d-none');\r\n                    $(\"#fieldSto_status\").html('Storage checking ....');\r\n\r\n                    AjaxJWT(url = \"/api/Home/StorageGet\"\r\n                        , data = JSON.stringify({})\r\n                        , async = true\r\n                        , success = function (result) {\r\n                            let _used = result;\r\n                            let _per = _used / sys_SpaceStorage;\r\n                            _per = (Math.round(_per * 100) / 100) * 100;\r\n                            _per = _per < 0 ? 0 : _per;\r\n                            _per = _per > 100 ? 100 : _per;\r\n\r\n                            $('#fieldSto_per').css('width', `${_per}%`);\r\n\r\n                            setTimeout(() => {\r\n                                $(\"#fieldSto_status\").html(`${Math.round(_used * 100) / 100} GB of ${sys_SpaceStorage} GB used`);\r\n                            }, 1000);\r\n                            if (_per > 80) {\r\n                                $('#fieldSto_per').addClass('bg-danger');\r\n                            }\r\n                            else if (_per > 50) {\r\n                                $('#fieldSto_per').addClass('bg-warning');\r\n                            }\r\n                            else {\r\n                                $('#fieldSto_per').addClass('bg-success');\r\n                            }\r\n                            resolve(result);\r\n                        }\r\n                    );\r\n                }\r\n                else {\r\n                    resolve(true);\r\n                }\r\n            })\r\n        }\r\n        function SysStorage_DetailView() {\r\n            window.open('/systeminfo/storage', '_blank');\r\n        }\r\n        function SysStorage_MarkAlertAsRead() {\r\n            setCookie('SpaceStorage', true, 3600);\r\n        }\r\n        //#endregion\r\n\r\n    </script>\r\n    <script src=\"https://accounts.google.com/gsi/client\"></script>\r\n    <script src=\"https://code.jquery.com/ui/1.13.2/jquery-ui.min.js\"></script>\r\n    <script>\r\n              \r\n        SWCache.LoadJSFooter();\r\n        SWCache.LoadSWFooter();\r\n        SWCache.LoadCSS([\r\n            \"/css/master.css\",\r\n            \"/css/mode.css\"\r\n        ]);\r\n    </script>\r\n    <style>\r\n\r\n        /*#region popup call */\r\n        #CallCenter_Area {\r\n            width: 380px;\r\n            max-width: 100%;\r\n            border: 2px solid #ffffff61;\r\n            border-radius: 2.5rem !important;\r\n        }\r\n\r\n            #CallCenter_Area .action {\r\n                background: #5f536f;\r\n            }\r\n\r\n        .navbar-collapse {\r\n            position: unset !important;\r\n        }\r\n\r\n        @media only screen and (max-width: 1200px) {\r\n            .mobile-sticky {\r\n                position: sticky;\r\n                top: 0px;\r\n                z-index: 100;\r\n            }\r\n        }\r\n        /*#endregion */\r\n        @media only screen and (max-width: 800px) {\r\n            .bodyfilterunique {\r\n                display: none !important;\r\n 