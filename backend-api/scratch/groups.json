"<div class=\"container-fluid py-0 px-0 mt-3\"> <div class=\"row m-0 px-2\"> <div class=\"col-12 px-0\"> <div class=\"card card-plain\"> <div class=\"card-body pt-0 px-0\"> <div class=\"row m-0\"> <div class=\"col-12 col-md-3 px-0\"> <div class=\"card card-plain\"> <div class=\"vtcardheader card-header p-0\"> <div class=left> <h6 class=\"mb-0 fw-bold\">Nh&#xF3;m</h6> <p class=\"text-sm mb-0\">Danh s&#xE1;ch</p> </div> <div class=right> <button class=\"btn bg-gradient-primary btn-sm mb-0\" data-value=\"fade up\" onclick=\"return mpl_groupAddnew()\"> Th&#xEA;m m&#x1EDB;i</button> </div> </div> <div class=\"card-body p-0 my-3\"> <div class=\"m-0 table-responsive\" style=\"max-height:calc(100vh - 259px)\"> <table id=mpl_type class=\"table vt-table mb-0\"><thead class=hiddenCollapse><tr role=row><th style=width:40px>#</th><th style=min-width:130px>Nh&#xF3;m</th></tr></thead><tbody id=mpl_typeBody> </tbody></table> </div> </div> </div> </div> <div class=\"col-12 col-md-9 ps-lg-4 px-0\"> <div class=\"vtcardheader card-header p-0\"> <div class=left> <h6 class=\"mb-0 fw-bold\">H&#xEC;nh th&#x1EE9;c thanh to&#xE1;n</h6> <p class=\"text-sm mb-0\">Danh s&#xE1;ch lo&#x1EA1;i chuy&#x1EC3;n kho&#x1EA3;n v&#xE0; pos</p> </div> <div class=right> <button class=\"btn bg-gradient-primary btn-sm mb-0 setting_projectclosure\" data-value=\"fade up\" onclick=\"return mpl_propAddNew()\">Th&#xEA;m m&#x1EDB;i</button> </div> </div> <div class=\"card-body p-0 my-3\"> <div class=\"m-0 table-responsive\" style=\"max-height:calc(100vh - 316px)\"> <table id=mpl_propTable name=dtContentMethodPayment class=\"table vt-table mb-0\"><thead class=hiddenCollapse><tr role=row><th class=d-none>ID</th><th class=no-sort style=width:40px>#</th><th class=no-sort>T&#xEA;n</th><th class=no-sort>Ghi ch&#xFA;</th><th class=no-sort>Ng&#x1B0;&#x1EDD;i s&#x1EED;a</th><th style=width:40px class=\"setting_projectclosure no-sort\">X&#xF3;a</th></tr></thead><tbody id=mpl_propBody> </tbody></table> </div> </div> </div> </div> </div> </div> </div> </div> </div><script>let mpl_groupChoose=0;let mpl_methodPaymentData=[];let DataUser;var mpl_isVN=(author_get('UserLang')=='vn'||author_get('UserLang')=='');$(document).ready(function(){Master_IndexDB_Reads(_Session_Data,[_Session_User],function(data){DataUser=data[0];});$('#mpl_propTable').tablecontrol();mpl_Event()\nmpl_groupLoadData();});function mpl_groupLoadData(){AjaxLoad(url=\"/Setting/MethodPayment/MethodPaymentList/?handler=LoadDataType\",data={},async=true,error=null,success=function(result){mpl_groupListRender(result,'mpl_typeBody');mpl_LOAD(0);});}\nfunction mpl_LOAD(ID=0){AjaxLoad(url=\"/Setting/MethodPayment/MethodPaymentList/?handler=LoadData\",data={id:ID},async=true,error=null,success=function(result){let data=result;if(ID==0){mpl_methodPaymentData=data;mpl_propRender(data,'mpl_propBody');}\nelse{let item=data[0]\nlet ele=document.getElementById(`mpl_itemProp_${item.ID}`)\nlet newRow=mpl_propRenderEach(item)\nlet existingIndex=mpl_methodPaymentData.findIndex(i=>i.ID===item.ID);if(existingIndex!==-1){mpl_methodPaymentData[existingIndex]=item;}else{mpl_methodPaymentData.push(item);}\nif(ele){$(ele).replaceWith(newRow);}else{let tableBody=document.getElementById('mpl_propBody');if(tableBody){tableBody.insertAdjacentHTML('beforeend',newRow);}}}});}\nfunction mpl_groupListRender(data,id){console.log(mpl_isVN)\nlet myNode=document.getElementById(id);if(myNode!=null){let stringContent='';if(data&&data.length>0){for(let i=0;i<data.length;i++){let item=data[i];let tr=``;if(i==0){tr=`\n\n                        <tr class=\"vt-number btnRow active\" data-id=\"0\">\n\n                            <td class=\"vt-number-order\"></td>\n\n                            <td>\n\n                                <span class=\"mb-0 text-sm fw-bold text-sm border-bottom border-dark cursor-pointer text-dark\" style=\"padding-bottom:1.5px!important;\">\n\n                                    T&#x1EA5;t c&#x1EA3;\n\n                                </span>\n\n                            </td>\n\n                        </tr>`}\ntr+=`<tr class=\"vt-number btnRow\" data-id=\"${item.ID}\">\n\n                        <td class=\"vt-number-order\"></td>\n\n                        <td>\n\n                            <span class=\"mb-0 btnEdit text-sm border-bottom border-dark cursor-pointer text-dark fw-bold\" data-id=\"${item.ID}\" style=\"padding-bottom:1.5px!important;\">\n\n                                ${ item.Name }\n\n                            </span>\n\n                        </td>\n\n                    </tr>`;stringContent+=tr;}}\nmyNode.innerHTML=stringContent;mpl_groupEvent()}}\nfunction mpl_propRender(data,id){let myNode=document.getElementById(id);if(myNode){myNode.innerHTML='';let stringContent='';if(data&&data.length>0){for(let i=0;i<data.length;i++){let item=data[i];if(item.ID!=''){stringContent+=mpl_propRenderEach(data[i]);}}}\nmyNode.innerHTML=stringContent;$('#mpl_propTable').tablesort();}\nChecking_TabControl_Permission();}\nfunction mpl_propRenderEach(item){let obj=Fun_GetObject_ByID(DataUser,item.PerEditor);let name=obj?obj.Name:'unknown';let img=obj?obj.Avatar:Master_Default_Pic;return`\n\n            <tr class=\"vt-number\" role=\"row\" id=\"mpl_itemProp_${item.ID}\">\n\n                <td class=\"d-none\">${item.ID}</td>\n\n                <td class=\"vt-number-order\"></td>\n\n                <td data_id=${item.ID}>\n\n                    <a class=\"text-sm border-bottom border-primary cursor-pointer fw-bold buttonEditClass\" href=\"#\" style=\"padding-bottom:1.5px!important;\">${item.Name}\n\n                        <p class=\"mb-0\">\n\n                         <span class=\"text-dark mb-0 text-sm border-bottom border-dark cursor-pointer\">${item.NameEN}</span>\n\n                        </p>\n\n                    </a>\n\n                </td>\n\n                <td>${item.Note}</td>\n\n                <td>\n\n                    <div class=\"d-flex\">\n\n                        <div class=\"icon icon-shape icon-sm me-2 text-center\">\n\n                            <img onerror=\"Master_OnLoad_Error_Image(this)\" class=\"avatar avatar-xs mt-2\" src=\"${img}\" alt=\"label-image\">\n\n                        </div>\n\n                        <div class=\"d-flex flex-column\">\n\n                            <h6 class=\"text-dark text-sm mb-0\">${name}</h6>\n\n                            <span class=\"text-xs\">${SysDate().FUTC(item.DayEditor).DateText()}</span>\n\n                        </div>\n\n                    </div>\n\n                </td>\n\n                <td class=\"setting_projectclosure\" data_id=${item.ID}>\n\n                    <button class=\"buttonGrid\" value=\"${item.ID}\">\n\n                        <svg class=\"vt-icon buttonDeleteClass\"><use href=\"#x\"></use></svg>\n\n                    </button>\n\n                </td>\n\n            </tr>\n\n        `;}\nfunction mpl_propRenderWithID(id){if(id!=0){AjaxLoad(url=\"/Setting/MethodPayment/MethodPaymentDetail/?handler=Loadata\",data={id:id},async=true,error=null,success=function(result){let dataDetail=result;let item=dataDetail[0]\nlet ele=document.getElementById(`mpl_itemProp_${id}`)\nlet newRow=mpl_propRenderEach(item)\nlet existingIndex=mpl_methodPaymentData.findIndex(i=>i.ID===item.ID);if(existingIndex!==-1){mpl_methodPaymentData[existingIndex]=item;}else{mpl_methodPaymentData.push(item);}\nif(ele){$(ele).replaceWith(newRow);}else{let tableBody=document.getElementById('mpl_propBody');if(tableBody){tableBody.insertAdjacentHTML('beforeend',newRow);}}});}}\nfunction mpl_Event(){$('#mpl_propTable tbody').on('click','.buttonDeleteClass',function(){let ID=Number($(this).closest('td').attr('data_id'));mpl_Delete(ID)});$('#mpl_propTable tbody').on('click','.buttonEditClass',function(){let ID=Number($(this).closest('td').attr('data_id'));mpl_Edit(ID);});}\nfunction mpl_groupEvent(){$(\"#mpl_typeBody .btnEdit\").off('click').click(function(){let id=$(this).attr('data-id');$(\"#mpl_typeBody .btnRow\").removeClass('active');$(this).closest('.btnRow').addClass('active');mpl_groupChoose=id\nmpl_filter();$(\"#DetailModal_Content\").html('');$(\"#DetailModal_Content\").load(\"/Setting/MethodPayment/MethodPaymentTypeDetail?CurrentID=\"+mpl_groupChoose+\"&ver=\"+versionofWebApplication);$('#DetailModal').modal('show');return false;})\n$(\"#mpl_typeBody .btnRow\").off('click').click(function(){$(this).addClass('active').siblings().removeClass('active');let id=$(this).attr('data-id');mpl_groupChoose=id;mpl_filter()\nreturn false;})}\nfunction mpl_filter(){if(!Array.isArray(mpl_methodPaymentData))return;for(let i=0;i<mpl_methodPaymentData.length;i++){const item=mpl_methodPaymentData[i];const row=$(`#mpl_itemProp_${item.ID}`);if(item.ID!=''){if(mpl_groupChoose!=0){if(item.TypeID==mpl_groupChoose){row.show();}else{row.hide();}}else{row.show();}}}}\nfunction mpl_Delete(id){const promise=notiConfirm();promise.then(function(){mpl_Execute_Delete(id);},function(){});}\nfunction mpl_Execute_Delete(id){AjaxLoad(url=\"/Setting/MethodPayment/MethodPaymentList/?handler=DeleteItem\",data={id:id},async=false,error=null,success=function(result){if(result==\"1\"){notiSuccess();mpl_LOAD();}else{notiError_SW();}});}\nfunction mpl_groupAddnew(){$(\"#DetailModal_Content\").html('');$(\"#DetailModal_Content\").load(\"/Setting/MethodPayment/MethodPaymentTypeDetail?CurrentID=0&ver=\"+versionofWebApplication);$('#DetailModal').modal('show');}\nfunction mpl_Edit(CurrentID){$(\"#DetailModal_Content\").html('');$(\"#DetailModal_Content\").load(\"/Setting/MethodPayment/MethodPaymentDetail?CurrentID=\"+CurrentID+\"&TypeID=\"+mpl_groupChoose+\"&ver=\"+versionofWebApplication);$('#DetailModal').modal('show');return false;}\nfunction mpl_propAddNew(){$(\"#DetailModal_Content\").html('');$(\"#DetailModal_Content\").load(\"/Setting/MethodPayment/MethodPaymentDetail\"+\"?TypeID=\"+mpl_groupChoose+\"&ver=\"+versionofWebApplication);$('#DetailModal').modal('show');return false;}\nfunction mpl_typeEdit(CurrentID){$(\"#DetailModal_Content\").html('');$(\"#DetailModal_Content\").load(\"/Setting/MethodPayment/MethodPaymentTypeDetail?CurrentID=\"+CurrentID+\"&ver=\"+versionofWebApplication);$('#DetailModal').modal('show');return false;}</script><script>SWCache.LoadJS_Async([\"/js/main.js\",\"/js/comon/initialize_setting.js\"]);</script>"