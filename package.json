{
  "name": "vttech-root",
  "version": "1.0.0",
  "scripts": {
    "dev": "./manage.sh",
    "dev:host": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:12003/db_tazagroup_vttech_sync concurrently \"npm run frontend\" \"npm run backend\"",
    "manage": "./manage.sh",
    "backend": "cd backend-api && bun run start:dev",
    "frontend": "cd vttech-dashboard && bun dev",
    "backend:host": "cd backend-api && DATABASE_URL=postgresql://postgres:postgres@localhost:12003/db_tazagroup_vttech_sync bun run start:dev",
    "frontend:host": "cd vttech-dashboard && DATABASE_URL=postgresql://postgres:postgres@localhost:12003/db_tazagroup_vttech_sync bun dev"
  },
  "devDependencies": {
    "prisma": "~6.2.1"
  },
  "dependencies": {
    "@prisma/client": "~6.2.1",
    "@radix-ui/react-progress": "^1.1.8",
    "concurrently": "^9.2.1"
  }
}